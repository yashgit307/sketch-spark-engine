# ---------------------------------------------------------------------------
# BIGPIKLE AUTOMATION - orchestrator settings (copy to .env)
# ---------------------------------------------------------------------------

# --- LLM script & prompt generator ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- TTS audio generator ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE_CODE=hi-IN
GOOGLE_TTS_VOICE_NAME=hi-IN-Wavenet-D

# --- GCP VM HTTP worker ---
VM_BASE_URL=http://<YOUR_VM_EXTERNAL_IP>:5000
VM_SECRET=
VM_TIMEOUT_SECONDS=1800
# Where the raw NotebookLM render lives. Local path => uploaded to the VM,
# /absolute/path => assumed to already exist on the VM.
RAW_VIDEO_PATH=/opt/sketch_spark_engine/output/raw_notebooklm_video.mp4
OUTPUT_FILENAME=chintu_magical_breakfast_final.mp4

# --- YouTube Data API ---
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/token.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=24
YOUTUBE_DEFAULT_TAGS=chintu,hindi cartoon,tech cartoon,notebooklm,magical breakfast

# --- Topic queue & outputs ---
TOPICS_FILE=data/topics.json
SCRIPTS_DIR=output/scripts
VOICEOVER_DIR=output/voiceovers
FINAL_DIR=output/final
# Optional custom thumbnail for the YouTube upload (empty = skip)
THUMBNAIL_PATH=

# --- Trigger: cron schedule (monday..sunday, HH:MM, 24h local time) ---
CRON_DAYS=monday,thursday
CRON_TIME=10:00

# --- Trigger: webhook mode ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=
