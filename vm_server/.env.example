# ---------------------------------------------------------------------------
# GCP VM worker settings (copy to /opt/sketch_spark_engine/.env)
# ---------------------------------------------------------------------------
VM_HOST=0.0.0.0
VM_PORT=5000
VM_SECRET=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

ASSETS_DIR=/opt/sketch_spark_engine/assets
OUTPUT_DIR=/opt/sketch_spark_engine/output
LOGO_FILE=logo_top_left.png
BGM_FILE=bgm_loop.mp3
OUTRO_FILE=logo_outro.mp4

# Bottom-right NotebookLM watermark region removed by the crop filter
# (w:h:x:y expressions evaluated by ffmpeg)
WATERMARK_CROP=iw-240:ih-140:0:0
LOGO_POSITION=20:20
BGM_VOLUME=0.15
TARGET_FPS=30
